# Copy this file to .env and fill in real values. Never commit .env.
DB_PATH=/app/data/parceltrack.db

# Shared accounts service. Same token as its SERVICE_TOKEN.
ACCOUNTS_URL=http://accounts:4600
ACCOUNTS_SERVICE_TOKEN=
# Set to false only for local development over plain http.
COOKIE_SECURE=true

# Optional: live tracking provider (see README). Leave empty for manual status.
TRACKING_PROVIDER=
TRACKING_API_KEY=
